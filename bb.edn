{:min-bb-version "1.0.0"
 ;; The build/test pipeline logic lives in bb/pipeline.clj (helpers can't be
 ;; shared via :init — bb analyzes task bodies before :init runs).
 :paths ["bb"]
 :tasks
 {test
  {:doc "Run every test suite — the same gate release.yml runs before building: plaid-core (Clojure), the plaid-ud / plaid-igt / plaid-dict / plaid-umr SPAs and the shared plaid-ui package (npm test and npm run lint, with an npm install first), and the Python assistant and bundled services (pytest, the assistant's suite booting a private plaid-core from source for its query engine, on its own port and database). Every Python step runs one interpreter, PLAID_PYTHON, else PLAID_AGENT_PYTHON, else the `plaid-agent` env's python, never the first `python` on PATH, with PYTHONPATH set to this checkout's plaid-client-py and plaid-agent sources. Prereqs: Node >= 24 active (e.g. `nvm use 24.1.0`) and the `plaid-agent` env. That env also needs `ancast`, which plaid-umr's comparison tests run for real (`pip install ancast`), the way release.yml installs it."
   :requires ([pipeline :as pl])
   :task (pl/run-tests!)}

  ci-fast
  {:doc "The per-push check ci.yml runs: cljfmt, the Clojure suite, every JavaScript package's lint, tests and build, and the Python suites (the assistant's against a private core). No fidelity, e2e or jar. Usage: bb ci-fast [cljfmt|core [I/N]|js [package]|python]. With no part it runs all four in turn. `core 2/4` runs one shard of the Clojure suite, `js plaid-igt` one JavaScript package (with what it needs installed first), as ci.yml's matrix does. It runs `npm ci` in every JavaScript package, which empties node_modules under a dev server. Prereqs as for `bb test`."
   :requires ([pipeline :as pl])
   :task (pl/run-fast-checks! *command-line-args*)}

  build
  {:doc "Build ALL release artifacts locally, like release.yml's build job (NO publishing). Usage: bb build [version] [--no-smoke] [--skip-clients]. version defaults to 0.0.0-alpha.0. Produces dist-artifacts/ (uberjar with the UD+IGT+dictionary+UMR SPAs, the JavaScript client served at /client/plaid-client.js, and the services bundled, npm .tgz, Python sdist+wheel for the client; the assistant is NOT staged, since it does not go to PyPI yet) and boot-smoke-tests the jar on :8080 (PLAID_SMOKE_PORT picks another port). Prereqs: Node >= 24 active (e.g. `nvm use 24.1.0`); for the Python client, the pipeline's one Python (as for `bb test`), or pass --skip-clients."
   :requires ([pipeline :as pl])
   :task (pl/build-artifacts! (pl/parse-build-args *command-line-args*))}

  ci
  {:doc "Run the whole non-publishing release pipeline locally: the test gate, then build all artifacts. Usage: bb ci [version] [--no-smoke] [--skip-clients]."
   :requires ([pipeline :as pl])
   :task (do (pl/run-tests!)
             (pl/build-artifacts! (pl/parse-build-args *command-line-args*)))}

  e2e
  {:doc "Run the Playwright suites, each on a core of its own: per app, a plaid-core from this checkout's source on a free port with a fresh database, an API token minted on it, the app's Vite dev server on another free port proxying /api to that core, then Playwright with one worker. Nothing reaches the dev core on :8085. Usage: bb e2e [igt|ud|umr ...] [-- <playwright args>], all three in turn with no app. Logs and Playwright output stay in a directory per run (under PLAID_E2E_DIR when set, else the temp dir). Prereqs: Node >= 24 active, `clojure` on PATH, each app installed (`npm ci` there) with its Playwright browser (`npx playwright install chromium`). Never runs `npm ci` itself. Nightly runs it."
   :requires ([e2e :as e2e])
   :task (e2e/run-e2e! *command-line-args*)}

  fidelity
  {:doc "Run the fidelity round trips: the kitchen-sink coverage check, the round trip through every format that can read back what it writes (against each format's loss list), every export through the format's OWN validator, the editor's optimistic mirror of each reshape against what the server keeps, an import stopped and resumed against a straight one, and a vocabulary TSV read back through Bulk Add. Each boots a private plaid-core from source on its own port and database, so nothing touches the dev core. Together they take roughly five to ten minutes. `realFiles.mjs` is NOT here, its corpora living outside the repo. Prereqs: Node >= 24 active, `clojure` on PATH, and plaid-igt installed (`npm ci` there, or `bb test`). Nightly runs this after `bb test`."
   :requires ([pipeline :as pl])
   :task (pl/run-fidelity!)}

  sample-prompts
  {:doc "Regenerate every assistant's prompt snapshot (plaid-agent/docs/igt/, docs/ud/ and docs/umr/SAMPLE_PROMPT.md) from the real prompt builders and tool tables. Run it in the same change as any tool or prompt edit: the test gate fails while a snapshot is stale. Uses the pipeline's one Python (PLAID_PYTHON, PLAID_AGENT_PYTHON or the `plaid-agent` env's), so no activation is needed."
   :requires ([pipeline :as pl])
   :task (pl/write-sample-prompts!)}

  docs
  {:doc "Build the documentation site locally into _site/ (mirrors .github/workflows/docs.yml — index/manual/query/dev + the UD, IGT and UMR guides via Asciidoctor, plus the JS/Py API references best-effort via node). No publishing; open _site/index.html to preview. Prereq: `gem install asciidoctor coderay`."
   :requires ([pipeline :as pl])
   :task (pl/build-docs!)}

  clean
  {:doc "Remove local build outputs: dist-artifacts/, the _site/ docs preview, the bundled SPAs/services/version.edn under plaid-core/resources, built jars, and the SPA dist/ dirs."
   :requires ([pipeline :as pl])
   :task (pl/clean!)}

  release
  {:doc "Cut a release. Usage: bb release 0.2.0-alpha.1  — validates a clean tree on master, tags vX.Y.Z, and pushes. The release.yml workflow then tests, builds, and publishes everything. The git tag is the sole source of truth for the version."
   :requires ([clojure.string :as str])
   :task
   (let [version (first *command-line-args*)
         tag     (str "v" version)
         fail    (fn [msg] (binding [*out* *err*] (println "✗" msg)) (System/exit 1))
         git-out (fn [& args]
                   (str/trim (:out (apply shell {:out :string} "git" args))))]
     (when-not version
       (fail "Usage: bb release <version>   e.g. bb release 0.2.0-alpha.1"))
     ;; Version shape: X.Y.Z, optionally -alpha.N / -beta.N / -rc.N (lock-step
     ;; alpha scheme — keep it identical to what release.yml expects to parse).
     (when-not (re-matches (re-pattern "\\d+\\.\\d+\\.\\d+(-(?:alpha|beta|rc)\\.\\d+)?") version)
       (fail (str "'" version "' is not X.Y.Z or X.Y.Z-(alpha|beta|rc).N")))
     ;; Must be on master (releases cut from master per repo convention).
     (let [branch (git-out "rev-parse" "--abbrev-ref" "HEAD")]
       (when-not (= branch "master")
         (fail (str "on branch '" branch "', not master"))))
     ;; Working tree must be clean.
     (when-not (str/blank? (git-out "status" "--porcelain"))
       (fail "working tree is not clean — commit or stash first"))
     ;; Tag must not already exist (versions are immutable once published).
     (let [{:keys [exit]} (shell {:continue true :out :string :err :string}
                                 "git" "rev-parse" "--verify" "--quiet" tag)]
       (when (zero? exit)
         (fail (str "tag " tag " already exists"))))
     ;; Warn if local master is behind/ahead of origin (non-fatal).
     (shell {:continue true} "git" "fetch" "--quiet" "origin" "master")
     (let [local  (git-out "rev-parse" "HEAD")
           remote (git-out "rev-parse" "origin/master")]
       (when (not= local remote)
         (binding [*out* *err*]
           (println "⚠ local master differs from origin/master — the tag will point at your local HEAD."))))
     (println (str "→ tagging " tag " and pushing…"))
     (shell "git" "tag" "-a" tag "-m" (str "Release " tag))
     (shell "git" "push" "origin" tag)
     (println (str "✓ pushed " tag))
     (println "  Watch the release: gh run watch   (or the repo's Actions tab)"))}}}

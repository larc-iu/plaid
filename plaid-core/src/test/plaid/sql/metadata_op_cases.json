{
  "about": "The metadata op cases, run by plaid-core (plaid.sql.metadata-op-cases-test), plaid-client-js (test/metadataOps.test.js) and plaid-client-py (tests/test_metadata_ops.py). Each case applies ops to metadata and gives the result, or an error, a substring of the message all three raise. The shape caps (depth, key count, string length, total size) are checked by the server only and are not here. Edit it by hand.",
  "cases": [
    {
      "name": "a deep set and a deep delete edit only the keys they name",
      "metadata": {
        "corefud": {
          "counts": {
            "c": 9,
            "i": 4
          },
          "entities": {
            "c8": "other-land-animal",
            "c9": "fish",
            "i3": "moon"
          }
        },
        "other": "untouched"
      },
      "ops": [
        {
          "op": "set",
          "path": [
            "corefud",
            "entities",
            "c10"
          ],
          "value": "bird"
        },
        {
          "op": "set",
          "path": [
            "corefud",
            "counts",
            "c"
          ],
          "value": 10
        },
        {
          "op": "delete",
          "path": [
            "corefud",
            "entities",
            "c8"
          ]
        }
      ],
      "result": {
        "corefud": {
          "counts": {
            "c": 10,
            "i": 4
          },
          "entities": {
            "c9": "fish",
            "c10": "bird",
            "i3": "moon"
          }
        },
        "other": "untouched"
      }
    },
    {
      "name": "set creates the missing objects along its path",
      "metadata": {
        "k": 1
      },
      "ops": [
        {
          "op": "set",
          "path": [
            "new",
            "a",
            "b"
          ],
          "value": 1
        }
      ],
      "result": {
        "k": 1,
        "new": {
          "a": {
            "b": 1
          }
        }
      }
    },
    {
      "name": "a one-key path replaces that top-level key whole",
      "metadata": {
        "a": {
          "x": 1
        }
      },
      "ops": [
        {
          "op": "set",
          "path": [
            "a"
          ],
          "value": {
            "y": 2
          }
        }
      ],
      "result": {
        "a": {
          "y": 2
        }
      }
    },
    {
      "name": "a deep set replaces the value at its end whole",
      "metadata": {
        "a": {
          "b": {
            "x": 1
          },
          "c": 2
        }
      },
      "ops": [
        {
          "op": "set",
          "path": [
            "a",
            "b"
          ],
          "value": {
            "y": 2
          }
        }
      ],
      "result": {
        "a": {
          "b": {
            "y": 2
          },
          "c": 2
        }
      }
    },

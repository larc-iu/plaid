    {
      "name": "set stores null and every falsy value, since deletion is its own op",
      "metadata": {},
      "ops": [
        {
          "op": "set",
          "path": [
            "n"
          ],
          "value": null
        },
        {
          "op": "set",
          "path": [
            "f"
          ],
          "value": false
        },
        {
          "op": "set",
          "path": [
            "z"
          ],
          "value": 0
        },
        {
          "op": "set",
          "path": [
            "e"
          ],
          "value": ""
        },
        {
          "op": "set",
          "path": [
            "m"
          ],
          "value": {}
        }
      ],
      "result": {
        "n": null,
        "f": false,
        "z": 0,
        "e": "",
        "m": {}
      }
    },

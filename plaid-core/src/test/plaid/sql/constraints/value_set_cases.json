    {"constraint":"deprels","value":"nsubj\u00a0:pass","allowed":true},
    {"constraint":"deprels","value":"\u00a0obj","allowed":true},
    {"constraint":"deprels","value":"det","allowed":false},
    {"constraint":"deprels","value":"\u00a0","allowed":true},
    {"constraint":"whole","value":"a b\u00a0","allowed":true},
    {"constraint":"whole","value":"a\u00a0b","allowed":false},
    {"constraint":"spaced","value":"N V","allowed":true},
    {"constraint":"spaced","value":"N  V","allowed":false}
  ]
}

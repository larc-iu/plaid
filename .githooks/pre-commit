#!/usr/bin/env bash
# Auto-format staged files with Prettier so nobody has to think about it.
# Version-controlled + shared via `core.hooksPath = .githooks` (run
# `git config core.hooksPath .githooks` once after a fresh clone).
#
# Scope: each subproject that has Prettier installed formats its own staged
# *.js/*.jsx/*.css using its own config. Add a subproject to PROJECTS below to
# enroll it. Other paths (plaid-core Clojure, etc.) pass through untouched.
#
# Behavior: formats the working-tree copy of each staged file and re-stages it,
# so the commit includes the formatting. If a subproject's Prettier isn't
# installed it warns and lets the commit through rather than blocking work.
set -euo pipefail

PROJECTS=(plaid-igt plaid-ud)

repo_root="$(git rev-parse --show-toplevel)"

for proj in "${PROJECTS[@]}"; do
  prettier="$repo_root/$proj/node_modules/.bin/prettier"

  # Staged (added/copied/modified) code files under this subproject, NUL-safe.
  mapfile -d '' staged < <(
    git diff --cached --name-only --diff-filter=ACM -z -- \
      "$proj/**/*.js" "$proj/**/*.jsx" "$proj/**/*.css"
  )
  [ ${#staged[@]} -eq 0 ] && continue

  if [ ! -x "$prettier" ]; then
    echo "pre-commit: Prettier not found at $proj/node_modules/.bin/prettier" >&2
    echo "pre-commit: run 'npm install' in $proj; skipping auto-format there." >&2
    continue
  fi

  # Invoke from the subproject so it picks up its .prettierrc.json +
  # .prettierignore; strip the leading '<proj>/' from each path.
  rel=()
  for f in "${staged[@]}"; do rel+=("${f#"$proj"/}"); done

  # --ignore-unknown + .prettierignore mean ignored files are skipped silently.
  ( cd "$repo_root/$proj" && "$prettier" --write --ignore-unknown "${rel[@]}" >/dev/null )

  git -C "$repo_root" add -- "${staged[@]}"
done
exit 0

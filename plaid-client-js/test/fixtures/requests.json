[
  {
    "name": "setConfig without expected sends the value as the body",
    "each": [["projects", "projects"], ["textLayers", "text-layers"], ["tokenLayers", "token-layers"], ["spanLayers", "span-layers"], ["relationLayers", "relation-layers"], ["vocabLayers", "vocab-layers"]],
    "js": ["<bundle>.setConfig", "L1", "igt", "tagsets", {"a-b": 1}],
    "sends": [{"method": "PUT", "path": "/api/v1/<kind>/L1/config/igt/tagsets", "body": {"a-b": 1}}]
  },
  {
    "name": "setConfig with expected sends the compare-and-set envelope",
    "each": [["projects", "projects"], ["textLayers", "text-layers"], ["tokenLayers", "token-layers"], ["spanLayers", "span-layers"], ["relationLayers", "relation-layers"], ["vocabLayers", "vocab-layers"]],
    "js": ["<bundle>.setConfig", "L1", "igt", "tagsets", {"new-key": 2}, "$undefined", {"expected": {"old-key": 1}}],
    "py": ["<bundle>.set_config", "L1", "igt", "tagsets", {"new-key": 2}],
    "py_kw": {"expected": {"old-key": 1}},
    "sends": [{"method": "PUT", "path": "/api/v1/<kind>/L1/config/igt/tagsets", "query": {"if-unchanged": "true"},
               "body": {"expected": {"old-key": 1}, "value": {"new-key": 2}}}]
  },
  {
    "name": "deleteConfig with expected sends it",
    "each": [["projects", "projects"], ["textLayers", "text-layers"], ["tokenLayers", "token-layers"], ["spanLayers", "span-layers"], ["relationLayers", "relation-layers"], ["vocabLayers", "vocab-layers"]],
    "js": ["<bundle>.deleteConfig", "L1", "ud", "language", "Clear it", {"expected": "en"}],
    "py": ["<bundle>.delete_config", "L1", "ud", "language", "Clear it"],
    "py_kw": {"expected": "en"},
    "sends": [{"method": "DELETE", "path": "/api/v1/<kind>/L1/config/ud/language",
               "query": {"audit-message": "Clear it", "if-unchanged": "true"}, "body": {"expected": "en"}}]
  },
  {
    "name": "an expected of null means the key was absent",
    "js": ["projects.setConfig", "P1", "igt", "languages", {"object": "Lezgian"}, "$undefined", {"expected": null}],
    "py": ["projects.set_config", "P1", "igt", "languages", {"object": "Lezgian"}],
    "py_kw": {"expected": null},
    "sends": [{"method": "PUT", "path": "/api/v1/projects/P1/config/igt/languages", "query": {"if-unchanged": "true"},
               "body": {"expected": null, "value": {"object": "Lezgian"}}}]
  },
  {
    "name": "options with no expected key write without a check",
    "js": ["projects.setConfig", "P1", "igt", "x", 1, "$undefined", {}],
    "py": ["projects.set_config", "P1", "igt", "x", 1],
    "sends": [{"method": "PUT", "path": "/api/v1/projects/P1/config/igt/x", "body": 1}]
  },
  {
    "name": "deleteConfig without expected sends no body",

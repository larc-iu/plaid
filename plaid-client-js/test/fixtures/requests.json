    "sends": [{"method": "PATCH", "path": "/api/v1/spans/bulk",
               "body": [{"id": "s1", "value": "NOUN", "metadata": [{"op": "set", "path": ["prov"], "value": "inferred"},
                                                                  {"op": "set", "path": ["provDetail", "valueProbs"], "value": {"someLabel": 0.9}}]},
                        {"id": "s2", "value": null}]}]
  },
  {
    "name": "a relation bulk update is one PATCH",

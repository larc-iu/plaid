{
  "name": "@larc-iu/plaid-client",
  "version": "0.0.0",
  "description": "JavaScript client for the Plaid annotation API",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larc-iu/plaid.git",
    "directory": "plaid-client-js"
  },
  "homepage": "https://github.com/larc-iu/plaid#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./testing": "./src/testing.js"
  },
  "scripts": {
    "test": "node --test",
    "types": "npm run clean-types && tsc -p .",
    "clean-types": "node -e \"const fs = require('fs'); for (const f of fs.readdirSync('src')) if (f.endsWith('.d.ts')) fs.rmSync('src/' + f)\"",
    "prepack": "npm run types",
    "postpack": "npm run clean-types"
  },
  "files": [
    "src/"
  ],
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
